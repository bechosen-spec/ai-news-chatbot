APP_ENV=development
DATABASE_URL=sqlite:///./ai_news.db
MODEL_PATH=ml/artifacts/selected_model.joblib
MODEL_METADATA_PATH=ml/artifacts/model_metadata.json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
ADMIN_API_KEY=replace-with-a-long-random-secret
INGESTION_TIMEOUT_SECONDS=15
INGESTION_RETRY_LIMIT=3
NEWS_EXCERPT_MAX_CHARACTERS=1500

# Phase 2B chat. Use long random bearer tokens mapped to stable server-side subjects.
# Never expose this mapping or any provider key to a browser bundle.
CHAT_ACCESS_TOKENS={"replace-reader-token":"reader-example"}
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_RETRY_LIMIT=2
LLM_MAX_OUTPUT_TOKENS=700
# Set LLM_API_KEY only in the deployment secret store when LLM_PROVIDER=openai.
RAG_MAX_QUESTION_CHARACTERS=2000
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_RESULT_LIMIT=6

